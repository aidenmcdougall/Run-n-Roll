# ---- Database (used by docker-compose and the backend) ----
POSTGRES_USER=runnroll
POSTGRES_PASSWORD=runnroll
POSTGRES_DB=runnroll
POSTGRES_PORT=5432
DATABASE_URL=postgres://runnroll:runnroll@localhost:5432/runnroll

# ---- Backend ----
PORT=3001
# Comma-separated list of allowed CORS origins (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Official DTP Bicycle Infrastructure Network GeoJSON (see README "Data")
BIN_DATASET_URL=https://opendata.transport.vic.gov.au/dataset/6cb739f0-ccf1-47a2-b215-192daf1e501a/resource/93e3301d-c559-44df-9435-01dfcad10794/download/bicycle_infrastructure_network.geojson

# Geofabrik OpenStreetMap extract for Victoria (see README "Data")
OSM_EXTRACT_URL=https://download.geofabrik.de/australia-oceania/australia/victoria-latest.osm.pbf

# ---- Frontend (Vite exposes only VITE_* variables) ----
# Backend origin the Vite dev server proxies /api requests to.
VITE_API_URL=http://localhost:3001
# Optional: API origin baked into production builds (leave empty to use same-origin /api).
VITE_API_BASE_URL=
# Any MapLibre style URL. Default: CARTO Positron (free, no API key).
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
